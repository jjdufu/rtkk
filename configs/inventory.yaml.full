# 示例占位。口令和地址按环境修改，不要把真实口令或内网地址提交到仓库。
vars:
  ansible_user: "root"
  ansible_ssh_pass: "change-me"
  # ansible_ssh_private_key_file: "~/.ssh/rtkk_ed25519"
  # ansible_become: false
  # ansible_become_method: "sudo"   # "sudo" (default) | "su"
  # ansible_become_user: "root"
  # ansible_become_pass: "change-me"
  # ansible_ssh_host_key_checking: false
  rtkk_bin: "./target/release/rtkk"
  rtkk_inventory: "configs/inventory.yaml"
  images_file: "configs/images.yaml"
  registry:
    url: "10.0.0.10/rtkk"
    host: "10.0.0.10"
    username: "admin"
    password: "change-me"
    # Auto-derived from username:password by rtkk when omitted or rotated
    auth_basic: "YWRtaW46Y2hhbmdlLW1l"
    insecure: true
    # Transport scheme: "auto" | "https" | "http"
    scheme: "auto"
    # Create Harbor project as public when true (default: true)
    harbor_project_public: true
    push_empty_policy: warn_ok
  image_sync:
    output_dir: "./downloads/images"
    platform: "linux/amd64"
    insecure: true
    retries: 3
    layer_concurrency: 4
    http_timeout_secs: 600
  pki_dir: "./pki"
  # Certificate validity period (99y default; "8760h" / "1y" / "10y" / "365d" also supported)
  cert_validity: "867240h"
  kube_version: "v1.37.2"
  etcd_version: "v3.7.4"
  # Containerd version (1.x renders config.toml v2; 2.x renders config.toml v3)
  containerd_version: "2.4.2"
  runc_version: "v1.5.3"
  cni_version: "v1.10.0"
  helm_version: "v4.3.2"
  control_plane_endpoint: "10.0.0.68:6443"
  # kube-vip ARP interface on control-plane nodes (must match primary NIC)
  vip_interface: "ens33"
  # Cluster networking (single source for kubeadm / Cilium / NodeLocalDNS)
  pod_subnet: "10.233.0.0/18"
  service_subnet: "10.233.64.0/18"
  cluster_dns_ip: "10.233.64.10"
  cluster_domain: "cluster.local"
  cluster_pool_mask_size: "24"
  nodelocaldns_ip: "169.254.20.10"
  # Public image sources -> Harbor transparent mirror mapping (containerd override_path = true)
  enable_public_registry_mirrors: true
  auto_create_mirror_projects: true
  public_registry_mirrors_fallback: false
  public_registry_default_mirror_project: "external"
  # strict_mirror_projects: false
  public_registry_mirrors:
    - host: "docker.io"
      project: "dockerhub"
    - host: "registry-1.docker.io"
      project: "dockerhub"
    - host: "index.docker.io"
      project: "dockerhub"
    - host: "registry.k8s.io"
      project: "k8s"
    - host: "quay.io"
      project: "quay"
    - host: "gcr.io"
      project: "gcr"
    - host: "k8s.gcr.io"
      project: "gcr"
    - host: "mirror.gcr.io"
      project: "gcr"
    - host: "ghcr.io"
      project: "ghcr"
    - host: "mcr.microsoft.com"
      project: "mcr"
    - host: "public.ecr.aws"
      project: "ecr-public"
    - host: "nvcr.io"
      project: "nvcr"
    - host: "registry.gitlab.com"
      project: "gitlab"
    - host: "code.forgejo.org"
      project: "forgejo"
    - host: "higress-registry.cn-hangzhou.cr.aliyuncs.com"
      project: "higress"
    - host: "registry.cn-hangzhou.cr.aliyuncs.com"
      project: "aliyun-hz"
    - host: "lscr.io"
      project: "lscr"
    - host: "docker.elastic.co"
      project: "elastic"
    - host: "icr.io"
      project: "icr"
    - host: "registry.redhat.io"
      project: "redhat"
    - host: "registry.access.redhat.com"
      project: "redhat"
    - host: "cgr.dev"
      project: "chainguard"
  # containerd certs.d hosts, auth, and mirror overrides for public image sources (used when enable_public_registry_mirrors is false)
  public_registries_insecure: false
  public_registries_auth: false
  # public_registries_fallback: true
  # public_registries_mirror: ""
  public_registries_mirrors: {}
  public_registries:
    - docker.io
    - registry-1.docker.io
    - index.docker.io
    - registry.k8s.io
    - quay.io
    - gcr.io
    - ghcr.io
    - higress-registry.cn-hangzhou.cr.aliyuncs.com
    - public.ecr.aws
    - code.forgejo.org
  coredns_version: "v1.14.6"
  kube_vip_version: "v1.3.2"
  pause_version: "3.10.2"
  nodelocaldns_version: "1.27.1"
  cilium_version: "v1.20.5"
  cilium_envoy_version: "v1.39.6-1794557904-dee711ff0e84b106edd0abcdd71961af1b870359"
  openebs_version: "4.6.0"
  # Pluggable CNI ("cilium" | "custom" | "none") and optional cluster addons
  cni_plugin: "cilium"
  # Cilium KPR, L2 announcements, externalIPs, and NIC device list
  cilium_kube_proxy_replacement: false
  # cilium_k8s_service_host: "10.0.0.68"
  # cilium_k8s_service_port: 6443
  cilium_l2_announcements: false
  # cilium_l2_lease_duration: "15s"
  # cilium_l2_lease_renew_deadline: "5s"
  # cilium_l2_lease_retry_period: "2s"
  cilium_external_ips: false
  cilium_devices: []
  addons:
    nodelocaldns: true
    openebs_localpv: true
  # Optional ordered list of custom .gtmpl or .yaml manifests applied on first control plane
  custom_manifests: []
  # Optional extra images ({name, source, target}) synchronized alongside core images
  extra_images: []
  # Debian 13 system dependency auto-convergence (uses ./downloads/tar/debian13-deps.tar.gz if present, else apt-get)
  auto_install_apt_deps: true
  extra_apt_packages: []
  dns_upstream: "10.0.0.111"
hosts:
  c23-p61: 10.0.0.61
  c23-p62: 10.0.0.62
  c23-p63: 10.0.0.63
  c23-p64: 10.0.0.64
  c23-p65: 10.0.0.65
  c23-p66: 10.0.0.66
roles:
  kube_control_plane: [c23-p61, c23-p62, c23-p63]
  kube_node: [c23-p64, c23-p65, c23-p66]
  etcd: [c23-p61, c23-p62, c23-p63]
  k8s_cluster: [kube_control_plane, kube_node]
