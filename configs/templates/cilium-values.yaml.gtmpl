image:
  override: "{{ .registry.url }}/cilium:{{ .cilium_version }}"
  pullPolicy: "IfNotPresent"
  useDigest: false

operator:
  replicas: {{ if gt (len .groups.k8s_cluster) 1 }}2{{ else }}1{{ end }}
  image:
    override: "{{ .registry.url }}/operator-generic:{{ .cilium_version }}"
    pullPolicy: "IfNotPresent"
    useDigest: false

envoy:
  enabled: true
  image:
    override: "{{ .registry.url }}/cilium-envoy:{{ .cilium_envoy_version }}"
    pullPolicy: "IfNotPresent"
    useDigest: false

ipam:
  mode: "cluster-pool"
  operator:
    clusterPoolIPv4PodCIDRList:
      - "{{ .pod_subnet }}"
    clusterPoolIPv4MaskSize: {{ int (default "24" .cluster_pool_mask_size) }}

routingMode: "tunnel"
tunnelProtocol: "vxlan"
{{- $kpr := ne (printf "%v" (default false .cilium_kube_proxy_replacement)) "false" }}
{{- $l2 := ne (printf "%v" (default false .cilium_l2_announcements)) "false" }}
{{- $extIps := ne (printf "%v" (default false .cilium_external_ips)) "false" }}
{{- if or $kpr $l2 }}
kubeProxyReplacement: "true"
k8sServiceHost: "{{ if .cilium_k8s_service_host }}{{ .cilium_k8s_service_host }}{{ else }}{{ index (splitList ":" .control_plane_endpoint) 0 }}{{ end }}"
k8sServicePort: {{ if .cilium_k8s_service_port }}{{ .cilium_k8s_service_port }}{{ else }}{{ index (splitList ":" .control_plane_endpoint) 1 }}{{ end }}
{{- else }}
kubeProxyReplacement: "false"
{{- end }}
{{- if $l2 }}
l2announcements:
  enabled: true
  leaseDuration: '{{ default "15s" .cilium_l2_lease_duration }}'
  leaseRenewDeadline: '{{ default "5s" .cilium_l2_lease_renew_deadline }}'
  leaseRetryPeriod: '{{ default "2s" .cilium_l2_lease_retry_period }}'
{{- end }}
{{- if or $extIps $l2 }}
externalIPs:
  enabled: true
{{- end }}
{{- if not (empty .cilium_devices) }}
devices:
{{- range .cilium_devices }}
  - "{{ . }}"
{{- end }}
{{- end }}

hubble:
  enabled: true
  relay:
    enabled: false
  ui:
    enabled: false
  tls:
    enabled: true
{{- if .cilium_ca_crt }}
    auto:
      enabled: false
    server:
      cert: "{{ .hubble_tls_crt.stdout }}"
      key: "{{ .hubble_tls_key.stdout }}"

tls:
  ca:
    cert: "{{ .cilium_ca_crt.stdout }}"
    key: "{{ .cilium_ca_key.stdout }}"
{{- else }}
    auto:
      enabled: true
      method: "helm"
{{- end }}
