apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ .ip }}
  bindPort: {{ index (splitList ":" .control_plane_endpoint) 1 }}
nodeRegistration:
  criSocket: unix:///var/run/containerd/containerd.sock
  imagePullPolicy: IfNotPresent
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: {{ .kube_version }}
controlPlaneEndpoint: {{ .control_plane_endpoint }}
imageRepository: {{ .registry.url }}
{{- if .coredns_version }}
dns:
  imageTag: {{ .coredns_version }}
{{- end }}
certificateValidityPeriod: {{ if .cert_validity_hours_str }}{{ .cert_validity_hours_str }}{{ else }}{{ default "867240h" .cert_validity }}{{ end }}
caCertificateValidityPeriod: {{ if .cert_validity_hours_str }}{{ .cert_validity_hours_str }}{{ else }}{{ default "867240h" .cert_validity }}{{ end }}
etcd:
  external:
    endpoints:
      {{- range .etcd_endpoints }}
      - {{ . }}
      {{- end }}
    caFile: /etc/ssl/etcd/ssl/ca.pem
    certFile: /etc/ssl/etcd/ssl/apiserver-etcd-client.pem
    keyFile: /etc/ssl/etcd/ssl/apiserver-etcd-client-key.pem
networking:
  dnsDomain: {{ .cluster_domain }}
  podSubnet: {{ .pod_subnet }}
  serviceSubnet: {{ .service_subnet }}
apiServer:
  extraEnvs:
    - name: KUBE_WATCHCACHE_CONSISTENCY_CHECKER
      value: "false"
  extraArgs:
    - name: authorization-mode
      value: Node,RBAC
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
clusterDNS:
  - {{ .cluster_dns_ip }}
clusterDomain: {{ .cluster_domain }}
resolvConf: "{{ if .kubelet_resolv_conf }}{{ .kubelet_resolv_conf }}{{ else if .detected_resolv_conf }}{{ default "/etc/resolv.conf" .detected_resolv_conf.stdout }}{{ else }}{{ default "/etc/resolv.conf" .kubelet_resolv_conf }}{{ end }}"
